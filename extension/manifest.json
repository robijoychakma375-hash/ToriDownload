{
  "manifest_version": 3,
  "name": "Tori Download Connector",
  "version": "0.22.0",
  "description": "Send direct browser downloads to the Tori Download desktop app.",
  "permissions": [
    "downloads",
    "storage",
    "contextMenus",
    "alarms"
  ],
  "host_permissions": [
    "http://127.0.0.1:8765/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [{
    "matches": ["http://*/*", "https://*/*"],
    "js": ["preclick.js", "video_overlay.js"],
    "run_at": "document_start",
    "all_frames": true
  }],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon48.png"
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "key": ""
}
